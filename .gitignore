# --- generated figures ------------------------------------------------------
# `python raincloud.py` rewrites these in the repo root on every run; the
# smaller copies the README embeds live in docs/ and stay tracked
/raincloud_*.png
/raincloud_*.svg
/raincloud_*.pdf
/raincloud_*.eps

